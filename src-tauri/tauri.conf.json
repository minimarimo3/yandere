{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Yandere Companion",
  "version": "0.1.16",
  "identifier": "local.yandere.companion",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Yandere Companion",
        "width": 390,
        "height": 640,
        "visible": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Productivity",
    "shortDescription": "A small companion that watches your work and occasionally talks to you.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
